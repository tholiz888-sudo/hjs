# Activate only after verifying Binance permits this deployment location.
# Keep the current working OKX service until the replacement is verified.
MARKET_EXCHANGE=binance
MARKET_AUTO_SYNC=1
MARKET_SYMBOL_LIMIT=all
MARKET_HISTORY_BARS=1000
MARKET_CACHE_SERIES=60
MARKET_REFRESH_SECONDS=60
BINANCE_WEIGHT_PER_MINUTE=1000
# Replace with an actual mounted persistent disk path:
DB_PATH=/var/data/jiange/app.sqlite
